# Variáveis de ambiente — copie para .env.local e preencha com os valores reais.
# NUNCA versione .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Conexão direta do Postgres (migrations e Supabase CLI).
# Não é usada pelo runtime da aplicação.
# Use sempre o Session Pooler (IPv4): postgresql://postgres.<ref>:SENHA@aws-0-<região>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Não existe chave secreta aqui: a gestão de usuários é feita no painel do Supabase
# e a aplicação usa somente a chave publicável, protegida por RLS.
