# Variáveis de ambiente — copie para .env.local e preencha com os valores reais.
# NUNCA versione .env.local nem a chave secreta.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Somente no servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Conexão direta do Postgres (migrations e Supabase CLI).
# Não é usada pelo runtime da aplicação.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
